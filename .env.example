OPENAI_API_KEY=key

ADT_BASE_HOST=https://sap.url

WORKFLOW_API_HOST=127.0.0.1
WORKFLOW_API_PORT=8775

WORKFLOW_WEB_HOST=127.0.0.1
WORKFLOW_WEB_PORT=5170

WORKFLOW_BROWSER_CDP_HOST=127.0.0.1
WORKFLOW_BROWSER_CDP_PORT=9219

# Authentication is disabled by default for local development.
# Set to entra to authenticate through Microsoft Entra ID / OpenID Connect.
MDEV_AUTH_MODE=disabled

# Microsoft Entra tenant and application registration.
MDEV_ENTRA_TENANT_ID=
MDEV_ENTRA_CLIENT_ID=
MDEV_ENTRA_CLIENT_SECRET=

# Must exactly match a Web redirect URI configured in the Entra app registration.
MDEV_ENTRA_REDIRECT_URI=http://localhost:8775/api/auth/callback

# Where MDEV sends the browser after authentication succeeds.
MDEV_ENTRA_POST_LOGIN_URL=http://localhost:5170

# Optional comma-separated initial allow-list of user email addresses/UPNs.
# These users are inserted into app_users when missing and can later be managed directly in the database.
MDEV_AUTH_BOOTSTRAP_USERS=user1@company.com,user2@company.com